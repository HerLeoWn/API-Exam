<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Hava Durumu Uygulaması</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <h1>Hava Durumu</h1>
      <form action="/" method="POST">
        <input
          type="text"
          name="city"
          placeholder="Şehir giriniz..."
          required
        />
        <button type="submit">Göster</button>
      </form>

      <% if (weather) { %>
      <div class="weather-box">
        <h2><%= city %> için hava durumu:</h2>
        <p><strong>Sıcaklık:</strong> <%= weather.temperature %></p>
        <p><strong>Rüzgar:</strong> <%= weather.wind %></p>
        <p><strong>Açıklama:</strong> <%= weather.description %></p>
      </div>
      <% } else if (error) { %>
      <div class="error-box">
        <p><%= error %></p>
      </div>
      <% } %>
    </div>
  </body>
</html>
